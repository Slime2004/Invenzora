<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Barcode Management"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Statistics Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_barcode_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading statistics..."
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_generate_all_barcodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Barcodes for All Items"
            android:layout_marginBottom="8dp"
            android:padding="16dp"/>

        <Button
            android:id="@+id/btn_view_missing_barcodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Items Missing Barcodes"
            android:layout_marginBottom="16dp"
            android:padding="16dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/background_light"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About Automatic Barcode Generation"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• System generates unique 12-digit barcodes\n• Based on item name, group, and timestamp\n• Ensures no duplicate barcodes exist\n• Compatible with barcode scanners\n• Existing items can have barcodes generated retroactively"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>