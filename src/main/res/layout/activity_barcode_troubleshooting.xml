<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔧 Barcode Troubleshooting"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Test Barcode Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Barcode"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/iv_test_barcode"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                android:background="@android:color/white"
                android:layout_marginBottom="8dp"
                android:contentDescription="Test Barcode"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_generate_test"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Generate Test"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_scan_test"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scan Test"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_run_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Run Detailed Diagnostics"
            android:layout_marginBottom="16dp"
            android:padding="16dp"/>

        <!-- Status Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/background_light"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diagnostic Results"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Running initial diagnostics..."
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- Common Issues Help -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❓ Common Scanning Issues"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 📱 Camera Permission: Make sure camera permission is granted\n\n2. 💡 Lighting: Use good lighting, avoid glare and shadows\n\n3. 📏 Distance: Hold device 6-8 inches from barcode\n\n4. 🎯 Focus: Ensure barcode fills the scanning area\n\n5. ⚡ Stability: Keep device steady while scanning\n\n6. 🔄 Orientation: Try both portrait and landscape modes\n\n7. 🧹 Clean Lens: Make sure camera lens is clean\n\n8. 📊 Barcode Quality: Ensure barcode is printed clearly\n\n9. 📱 Device: Some older devices may have scanning limitations"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>